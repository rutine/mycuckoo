<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- 
    说明: DictionaryMapper映射文件
    
    @author rutine
    @version 5.0.0
 -->
<mapper namespace="com.mycuckoo.repository.platform.DictionaryMapper">
    <resultMap id="baseMap" type="com.mycuckoo.domain.platform.Dictionary">
        <id property="dictId" column="dict_id" />
        <result property="code" column="code" />
        <result property="name" column="name" />
        <result property="memo" column="memo" />
        <result property="status" column="status" />
        <result property="updator" column="updator" />
        <result property="updateTime" column="update_time" />
        <result property="creator" column="creator" />
        <result property="createTime" column="create_time" />
    </resultMap>
    
    <sql id="columns">
        dict_id, code, name, memo, status,
        updator, update_time, creator, create_time
    </sql>
    
    <sql id="table">
        sys_dictionary
    </sql>

    <!-- 插入字典：由数据库生成id并赋值到Dictionary对象 -->
    <insert id="save" parameterType="com.mycuckoo.domain.platform.Dictionary"
            useGeneratedKeys="true" keyProperty="dictId" keyColumn="dict_id">
        insert into <include refid="table" />
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="dictId != null">dict_id, </if>
            <if test="code != null and code != ''">code, </if>
            <if test="name != null and name != ''">name, </if>
            <if test="memo != null and memo != ''">memo, </if>
            <if test="status != null">status, </if>
            <if test="updator != null">updator, </if>
            <if test="updateTime != null">update_time, </if>
            <if test="creator != null">creator, </if>
            <if test="createTime != null">create_time, </if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="dictId != null">#{dictId}, </if>
            <if test="code != null and code != ''">#{code}, </if>
            <if test="name != null and name != ''">#{name}, </if>
            <if test="memo != null and memo != ''">#{memo}, </if>
            <if test="status != null">#{status}, </if>
            <if test="updator != null">#{updator}, </if>
            <if test="updateTime != null">#{updateTime}, </if>
            <if test="creator != null">#{creator}, </if>
            <if test="createTime != null">#{createTime}, </if>
        </trim>
    </insert>
    
    <!-- 更新字典 -->
    <update id="update" parameterType="com.mycuckoo.domain.platform.Dictionary">
        update <include refid="table" />
        <set>
            <if test="code != null">code = #{code}, </if>
            <if test="name != null">name = #{name}, </if>
            <if test="memo != null">memo = #{memo}, </if>
            <if test="status != null">status = #{status}, </if>
            <if test="updator != null">updator = #{updator}, </if>
            <if test="updateTime != null">update_time = #{updateTime}, </if>
        </set>
        where dict_id = #{dictId}
    </update>
    
    <!-- 删除字典 -->
    <delete id="delete" parameterType="long">
        delete from <include refid="table" /> where dict_id = #{id}
    </delete>
    
    <!-- 获取字典 -->
    <select id="get" parameterType="long" resultMap="baseMap">
        select <include refid="columns" />
        from <include refid="table" />
        where dict_id = #{id}
    </select>
    
    <!-- 根据字典名称及编码分页查询字典 -->
    <select id="findByPage" parameterType="map" resultMap="baseMap">
        select <include refid="columns" />
        from <include refid="table" />
        <where>
            <if test="q.code != null">
                code like concat('%', #{q.code}, '%')
            </if>
            <if test="q.name != null">
                and name like concat('%', #{q.name}, '%')
            </if>
        </where>
        order by dict_id desc
    </select>

    <!-- 根据编码统计字典数量 -->
    <select id="countByCode" parameterType="string" resultType="int">
        select count(1)
        from <include refid="table" />
        where code = #{code}
    </select>
    
    <!-- 根据字典ID修改字典状态 -->
    <update id="updateStatus">
        update <include refid="table" />
        set status = #{status}
        where dict_id = #{dictId}
    </update>
    
</mapper> 