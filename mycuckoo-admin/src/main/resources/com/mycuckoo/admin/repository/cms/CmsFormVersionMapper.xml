<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mycuckoo.admin.repository.cms.CmsFormVersionMapper">
    <resultMap id="baseMap" type="com.mycuckoo.admin.entity.cms.CmsFormVersion">
        <id property="id" column="id" />
        <result property="formId" column="form_id" />
        <result property="version" column="version" />
        <result property="config" column="config" />
        <result property="creator" column="creator" />
        <result property="createTime" column="create_time" />
    </resultMap>

    <sql id="columns">
        id, form_id, version, config, creator, create_time
    </sql>

    <sql id="table">
        cms_form_version
    </sql>

    <insert id="save" parameterType="com.mycuckoo.admin.entity.cms.CmsFormVersion"
            useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        insert into <include refid="table" />
        (form_id, version, config, creator, create_time)
        values
        (#{formId}, #{version}, #{config}, #{creator}, now())
    </insert>

    <delete id="deleteByFormId" parameterType="long">
        delete from <include refid="table" /> where form_id = #{formId}
    </delete>

    <select id="get" resultMap="baseMap">
        select <include refid="columns" />
        from <include refid="table" />
        where form_id = #{formId} and version = #{version}
    </select>

    <select id="listByFormId" resultMap="baseMap">
        select <include refid="columns" />
        from <include refid="table" />
        where form_id = #{formId}
        order by version desc
    </select>

    <select id="getByVersion" resultMap="baseMap">
        select <include refid="columns" />
        from cms_form_version
        where form_id = #{formId} and version = #{version}
    </select>
</mapper>